# 数据库配置
# 使用 SQLite (无需安装数据库)
DB_TYPE=sqlite

# 如需使用 MySQL，取消下方注释并填入配置
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=skill_report
# DB_USER=root
# DB_PASSWORD=your_password

# Flask 配置
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# 文件目录
OUTPUT_FOLDER=./output
